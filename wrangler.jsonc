{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-demo",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "BACKUP",
      "bucket_name": "chat-demo-sync"
    }
  ]
}
